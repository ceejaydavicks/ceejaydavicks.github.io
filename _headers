# ============================================================================
# Cloudflare Pages browser cache policy.
#
# Rules here apply to STATIC ASSET responses only — Cloudflare does not apply
# `_headers` to responses produced by Pages Functions. HTML, watch pages and
# JS/CSS are therefore also handled in functions/_middleware.js, which sets the
# same `no-cache` / immutable values on the Function response. These static
# rules are the safe fallback for any request that bypasses the Function.
#
# Rule of thumb: a long `immutable` cache is only safe when the URL itself
# changes whenever the bytes change. Images/fonts use fixed names that are
# never overwritten; JS/CSS now always carry `?v=<deploy version>` in the HTML,
# and the middleware gives only those versioned URLs the immutable header.
# ============================================================================

# ---- Images and fonts: fixed filenames, safe to cache for a year ----------
/assets/*.png
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/assets/*.webp
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/assets/*.jpg
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/assets/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/assets/*.svg
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/assets/*.gif
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/assets/*.ico
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/assets/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/assets/samples/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/favicon-32.png
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/favicon-192.png
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# ---- JS/CSS without a version: revalidate every time ----------------------
# The middleware upgrades `/assets/x.js?v=<version>` to immutable. Anything
# requested without that version (old bookmarks, crawlers, stale HTML) must
# never be stored for an hour or served stale-while-revalidate.
/assets/*.css
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
/assets/*.js
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
/videos.js
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

# ---- HTML: revalidate every time ------------------------------------------
# A cached HTML page would keep pointing at the previous deploy's asset URLs.
/
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
/*.html
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
/watch
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
/watch/
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
/admin
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
/admin/
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
